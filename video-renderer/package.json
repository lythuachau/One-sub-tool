{
  "name": "subtitle-video-maker",
  "version": "0.1.0",
  "private": true,

  "scripts": {
    "start": "node scripts/start-frontend.js",
    "start-react": "cross-env PORT=3034 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "studio": "remotion studio src/remotion/index.ts",
    "server:build": "tsc --project server/tsconfig.json",
    "server:start": "cross-env PORT=3033 node server/dist/index.js",
    "server:dev": "concurrently \"npm run start\" \"npm run server:start\""
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "plugins": [
      "@remotion"
    ],
    "overrides": [
      {
        "files": [
          "src/remotion/*.{ts,tsx}"
        ],
        "extends": [
          "plugin:@remotion/recommended"
        ]
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
